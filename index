const fmtINR = n => {
  n = Number(n) || 0;
  const isNeg = n < 0;
  n = Math.abs(n);
  let s = n.toFixed(2);
  let [int, dec] = s.split('.');
  let last3 = int.slice(-3);
  let rest = int.slice(0, -3);
  if (rest !== '') last3 = ',' + last3;
  let formatted = rest.replace(/\B(?=(\d{2})+(?!\d))/g, ",") + last3;
  return (isNeg ? '-' : '') + '₹' + formatted + (dec !== '00' ? '.' + dec : '');
};
// jsPDF's built-in fonts don't include the ₹ glyph, so PDF content uses "Rs." instead.
const fmtINRPdf = n => fmtINR(n).replace('₹', 'Rs. ');
